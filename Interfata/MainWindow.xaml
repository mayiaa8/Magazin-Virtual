<Window x:Class="Interfata.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minimarket" Height="700" Width="950"
        Loaded="Window_Loaded" WindowStartupLocation="CenterScreen">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#000000" Offset="0.0" />
            <GradientStop Color="#1E3A8A" Offset="1.2" />
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5,15,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="MenuButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="60"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="0,10,0,10"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#60A5FA"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                        <Border Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">

        <StackPanel x:Name="MeniuPrincipal" VerticalAlignment="Center" HorizontalAlignment="Center" Width="300" Visibility="Visible">
            <TextBlock Text="🏪 Meniu Minimarket" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30" Foreground="#60A5FA"/>
            <Button Content="Adăugare Produs" Style="{StaticResource MenuButtonStyle}" Click="Nav_Adaugare_Click"/>
            <Button Content="Vânzare Produs" Style="{StaticResource MenuButtonStyle}" Click="Nav_Vanzare_Click"/>
            <Button Content="Stoc / Editare" Style="{StaticResource MenuButtonStyle}" Click="Nav_Stoc_Click"/>
        </StackPanel>

        <Grid x:Name="PaginaAdaugare" Visibility="Collapsed">
            <StackPanel Width="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="✨ Adăugă un Produs Nou" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="#60A5FA"/>

                <TextBlock Text="Nume:"/>
                <TextBox x:Name="txtNume"/>

                <TextBlock Text="Preț (RON):"/>
                <TextBox x:Name="txtPret"/>

                <TextBlock Text="Cantitate:"/>
                <TextBox x:Name="txtCantitate"/>

                <TextBlock Text="Categorie:"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                    <RadioButton x:Name="rbAliment" Content="Aliment" IsChecked="True" GroupName="CatA"/>
                    <RadioButton x:Name="rbBautura" Content="Băutură" GroupName="CatA"/>
                    <RadioButton x:Name="rbDulciuri" Content="Dulciuri" GroupName="CatA"/>
                    <RadioButton x:Name="rbIgiena" Content="Igiena" GroupName="CatA"/>
                </StackPanel>

                <Button Content="➕ Salvează Produs" Background="#2563EB" Click="btnAdauga_Click" Margin="0,0,0,10"/>
                <Button Content="↩️ Înapoi la Meniu" Background="#475569" Click="Nav_Inapoi_Click"/>

                <TextBlock x:Name="txtStatusAdaugare" TextAlignment="Center" FontWeight="Bold" Margin="0,15,0,0"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="PaginaVanzare" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,25,0">
                <TextBlock Text="🛒 Vânzare" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="#60A5FA"/>
                <TextBlock Text="Filtrează lista sau selectează un produs din tabel pentru a-l vinde." Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,20" FontSize="14"/>

                <TextBlock Text="🔍 Caută după nume:" FontSize="14" Foreground="#38BDF8"/>
                <TextBox x:Name="txtCautaVanzare" TextChanged="txtCautaVanzare_TextChanged"/>

                <TextBlock Text="Cantitate dorită:"/>
                <TextBox x:Name="txtCantitateVanzare"/>

                <Button Content="Efectuează Vânzare" Background="#EA580C" Click="btnVinde_Click" Margin="0,0,0,10"/>
                <Button Content="↩️ Înapoi" Background="#475569" Click="Nav_Inapoi_Click"/>

                <TextBlock x:Name="txtStatusVanzare" TextAlignment="Center" FontWeight="Bold" TextWrapping="Wrap" Margin="0,15,0,0"/>
            </StackPanel>

            <DataGrid Grid.Column="1" x:Name="dgvVanzare" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" 
                      Background="#1E293B" RowBackground="#1E293B" AlternatingRowBackground="#0F172A" Foreground="White" 
                      HeadersVisibility="Column" FontSize="16" RowHeight="40" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="Nume Produs" Binding="{Binding Nume}" Width="*"/>
                    <DataGridTextColumn Header="Categorie" Binding="{Binding Categorie}" Width="120"/>
                    <DataGridTextColumn Header="Preț (RON)" Binding="{Binding Pret, StringFormat={}{0:F2}}" Width="110"/>
                    <DataGridTextColumn Header="Stoc" Binding="{Binding Cantitate}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid x:Name="PaginaStoc" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,25,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="📦 Stoc Curent" FontSize="24" FontWeight="Bold" Margin="0,0,0,10" Foreground="#60A5FA"/>

                <StackPanel Grid.Row="1" Margin="0,0,0,15">
                    <TextBlock Text="🔍 Caută produs după nume:" FontSize="14" Foreground="#38BDF8"/>
                    <TextBox x:Name="txtCautaStoc" TextChanged="txtCautaStoc_TextChanged" Margin="0,5,0,0"/>
                </StackPanel>

                <DataGrid Grid.Row="2" x:Name="dgvStoc" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" 
                          Background="#1E293B" RowBackground="#1E293B" AlternatingRowBackground="#0F172A" Foreground="White"
                          HeadersVisibility="Column" FontSize="16" RowHeight="40" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                        <DataGridTextColumn Header="Nume Produs" Binding="{Binding Nume}" Width="*"/>
                        <DataGridTextColumn Header="Categorie" Binding="{Binding Categorie}" Width="120"/>
                        <DataGridTextColumn Header="Preț (RON)" Binding="{Binding Pret, StringFormat={}{0:F2}}" Width="110"/>
                        <DataGridTextColumn Header="Stoc" Binding="{Binding Cantitate}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,15,0,0">
                    <Button Content="↩️ Înapoi la Meniu" Background="#475569" Click="Nav_Inapoi_Click" Width="180"/>
                    <TextBlock x:Name="txtStatusStoc" FontWeight="Bold" Margin="20,10,0,0"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="1" Background="#1E293B" Margin="20">
                <TextBlock Text="✏️ Editare Produs" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="#38BDF8"/>
                <Button Content="Modifică Produsul Selectat" Background="#0D9488" Click="btnIncepeEditare_Click" Margin="0,0,0,25"/>

                <StackPanel x:Name="panouEditare" Visibility="Collapsed">
                    <TextBlock Text="Nume nou:"/>
                    <TextBox x:Name="txtEditNume"/>
                    <TextBlock Text="Preț nou:"/>
                    <TextBox x:Name="txtEditPret"/>
                    <TextBlock Text="Cantitate nouă:"/>
                    <TextBox x:Name="txtEditCantitate"/>
                    <Button Content="💾 Salvează Modificările" Background="#2563EB" Click="btnSalveazaEdit_Click" Margin="0,10,0,0"/>

                    <TextBlock x:Name="txtStatusEditare" TextAlignment="Center" FontWeight="Bold" Margin="0,15,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

    </Grid>
</Window>